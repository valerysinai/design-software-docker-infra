# Plantilla de configuracion por ambiente. Copiar a .env.<ambiente> y completar.
# NOTA: en compose el password se interpola; un '$' literal se escribe '$$'.
POSTGRES_DB=design-software-develop
POSTGRES_USER=design_software_user
POSTGRES_PASSWORD=change-me
# Puerto host por ambiente: develop=15432 qa=15433 staging=15434 main=15435
POSTGRES_PORT=15432
# Nombre de proyecto compose por ambiente: ds-develop|ds-qa|ds-staging|ds-main
# (aisla contenedor/volumen por ambiente; sin esto los 4 comparten datos)
COMPOSE_PROJECT_NAME=ds-develop
# Usuario de aplicacion (least-privilege) que usan los servicios
APP_DB_USER=design_software_app
APP_DB_PASSWORD=change-me-app
# Ruta a la carpeta con los repos -db (relativa al compose o absoluta). Default: ..
DB_REPOS_DIR=..
# Ruta a la carpeta con los repos de backend (relativa al compose o absoluta). Default: ..
# NUNCA apuntar a un worktree privado de una HU: el build debe ser reproducible para cualquiera.
BACKEND_REPOS_DIR=..

# Docker Desktop local puede requerir el endpoint TCP porque el socket Unix montado puede
# fallar al ser leido desde contenedores. En Linux/CI dejar vacio para usar el socket Unix.
# TRAEFIK_DOCKER_ENDPOINT=tcp://host.docker.internal:2375
TRAEFIK_DOCKER_ENDPOINT=
# Permite fijar la API usada por clientes Docker cuando el daemon local lo requiera.
TRAEFIK_DOCKER_API_VERSION=1.44
# Si el provider Docker de Docker Desktop responde 400 en local, usar el override:
# docker compose -f docker-compose.yml -f docker-compose.traefik-local.yml ...
# Ese override mantiene las rutas /iam y /scheduling con provider file para validar gateway.
# HU-SCH-010/011: arranque completo Scheduling con un solo comando:
# ./scripts/up-scheduling-stack.ps1 -EnvFile .env -LocalTraefik
# o en Linux: LOCAL_TRAEFIK=true ./scripts/up-scheduling-stack.sh .env

# --- iam-service (perfil `iam`) -----------------------------------------------------
# Sin defaults de secreto: el servicio rehusa arrancar si faltan.
# IAM_JWT_ISSUER: claim 'iss' de los access tokens (p. ej. https://iam.design-software.local)
IAM_JWT_ISSUER=
# IAM_JWT_PRIVATE_KEY: clave privada RSA PKCS#8, en una sola linea (base64 del DER; el PEM
# con saltos de linea tambien funciona pero no entra en una sola linea de .env).
# Generar para desarrollo local con:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform DER -out /tmp/iam-dev.der
#   base64 -w0 /tmp/iam-dev.der
IAM_JWT_PRIVATE_KEY=
IAM_JWKS_URI=http://iam-api:8080/api/v1/auth/.well-known/jwks.json

# --- actors-service IAM event consumer (HU-ACT-013) -------------------------------
# Estos valores deben coincidir con broker/definitions.json. AMQP usa 5672; 15672 es
# solo la consola HTTP de administracion de RabbitMQ.
ACTORS_IAM_CONSUMER_ENABLED=true
ACTORS_IAM_QUEUE=actors-service.iam
ACTORS_IAM_DLX=actors-iam-dlx
ACTORS_IAM_DLQ=actors-events.dlq
# Local HU-IAM-017 / HU-ACT-019 mTLS material. Generate locally; never commit certificates.
TLS_DIR=./tls
IAM_ACTORS_MTLS_KEY_STORE_PASSWORD=localdev
IAM_ACTORS_MTLS_TRUST_STORE_PASSWORD=localdev
ACTORS_TLS_KEY_STORE_PASSWORD=localdev
ACTORS_TLS_TRUST_STORE_PASSWORD=localdev
